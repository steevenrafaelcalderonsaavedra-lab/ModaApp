<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/rosa_claro">


    <!-- TÍTULO -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_catalogo"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/rosa_principal"/>


    <!-- CATEGORÍAS -->

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Polos"/>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pantalones"/>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vestidos"/>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Casacas"/>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zapatillas"/>

        </LinearLayout>

    </HorizontalScrollView>


    <!-- MENSAJE -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/catalogo_vacio"
        android:textColor="@color/gris"
        android:textSize="18sp"/>


    <!-- CARRITO -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCarrito"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="@string/carrito"
        android:textColor="@color/blanco"
        app:backgroundTint="@color/rosa_principal"
        app:cornerRadius="25dp"/>

</LinearLayout>