<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rosa_claro"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="30dp">

        <!-- ESPACIO SUPERIOR -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="50dp"/>

        <!-- LOGO -->
        <TextView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:gravity="center"
            android:text="M"
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="@color/blanco"
            android:background="@color/rosa_principal"/>

        <!-- NOMBRE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/titulo_modaapp"
            android:textColor="@color/negro"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <!-- SUBTÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="35dp"
            android:text="@string/subtitulo"
            android:textColor="@color/gris"
            android:textSize="15sp"/>


        <!-- USUARIO -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/usuario"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/rosa_principal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"/>

        </com.google.android.material.textfield.TextInputLayout>


        <!-- CONTRASEÑA -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:hint="@string/contrasena"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/rosa_principal"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"/>

        </com.google.android.material.textfield.TextInputLayout>


        <!-- BOTÓN ADMINISTRADOR -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:text="@string/ingresar"
            android:textColor="@color/blanco"
            app:backgroundTint="@color/rosa_principal"
            app:cornerRadius="25dp"/>


        <!-- BOTÓN CLIENTE -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCatalogo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="@string/ver_catalogo"
            android:textColor="@color/rosa_principal"
            app:backgroundTint="@color/blanco"
            app:cornerRadius="25dp"
            app:strokeColor="@color/rosa_principal"
            app:strokeWidth="2dp"/>


        <!-- CREDENCIALES DE PRUEBA -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/credenciales_prueba"
            android:textColor="@color/gris"
            android:textSize="13sp"/>

    </LinearLayout>

</ScrollView>