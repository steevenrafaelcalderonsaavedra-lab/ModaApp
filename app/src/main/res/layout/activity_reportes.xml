<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reportes"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>


        <!-- ======================= -->
        <!-- PEDIDOS -->
        <!-- ======================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pedidos"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvTotalPedidos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total de pedidos: 0"
                    android:textSize="17sp"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvPendientes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pendientes: 0"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/tvAtendidos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Atendidos: 0"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/tvTotalVendido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total vendido: S/ 0.00"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ======================= -->
        <!-- INVENTARIO -->
        <!-- ======================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inventario"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvTotalRopa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modelos registrados: 0"
                    android:textSize="17sp"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvTotalStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unidades disponibles: 0"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/tvStockBajo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Productos con stock bajo: 0"
                    android:textSize="17sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ======================= -->
        <!-- CLIENTES -->
        <!-- ======================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clientes"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvTotalClientes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clientes registrados: 0"
                    android:textSize="17sp"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActualizar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Actualizar reportes"/>

    </LinearLayout>

</ScrollView>